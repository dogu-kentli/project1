<!doctype html>
<html lang="tr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>3D Kitap Görünümü</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--paper:#eee3c9;--ink:#3b2e20;--cover-color:#d8bf66;--cover-shadow:#a67a2d}
body{min-height:100vh;overflow:hidden;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#050505;perspective:1800px}
body:before{content:"";position:absolute;z-index:1;inset:50% auto auto 50%;width:min(760px,100vw);height:min(820px,100vh);transform:translate(-50%,-52%);pointer-events:none;background:radial-gradient(ellipse 240px 360px at 50% 44%,rgba(255,232,181,.3),rgba(255,218,143,.16) 34%,rgba(255,205,125,.05) 58%,transparent 76%);filter:blur(12px)}
.particles{position:absolute;inset:0;pointer-events:none;z-index:0}.particle{position:absolute;border-radius:50%;opacity:0;filter:blur(1.5px);background:radial-gradient(circle,rgba(255,225,180,.7),transparent 70%);animation:float var(--duration) ease-in-out infinite}@keyframes float{0%{transform:translate(var(--x),var(--y)) scale(.5);opacity:0}30%{opacity:var(--opacity);transform:translate(calc(var(--x) + var(--dx)*.3),calc(var(--y) + var(--dy)*.3)) scale(1)}70%{opacity:var(--opacity);transform:translate(calc(var(--x) + var(--dx)*.7),calc(var(--y) + var(--dy)*.7)) scale(.9)}100%{transform:translate(calc(var(--x) + var(--dx)),calc(var(--y) + var(--dy))) scale(.3);opacity:0}}
.book-container{--closed-book-width:300px;--open-book-width:640px;width:var(--closed-book-width);height:calc(var(--closed-book-width)*1.563333);position:relative;perspective:2000px;cursor:grab;user-select:none;z-index:10;touch-action:none;animation:idle 6s ease-in-out infinite;transition:width 1.2s cubic-bezier(.25,1,.5,1),height .8s ease}.book-container.open{width:var(--open-book-width);height:calc(var(--open-book-width)*.7328125)}.book-container.open .book{width:100%;left:0;transform:none!important;transition:width .8s ease}@keyframes idle{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}.book-container:active,.book-container.rotation-active{animation:none}.book-container:active{cursor:grabbing}.book-container:before{content:"";position:absolute;z-index:0;top:-65px;left:-135px;width:var(--closed-book-width);height:100%;pointer-events:none;background:radial-gradient(ellipse at 50% 44%,rgba(255,238,193,.22),rgba(255,218,143,.08) 42%,transparent 70%);filter:blur(14px)}
.fairy-dust{position:absolute;inset:-30% -45%;z-index:40;pointer-events:none;mix-blend-mode:screen}.fairy-dust span{position:absolute;width:var(--size);height:var(--size);left:var(--left);top:var(--top);border-radius:50%;background:#fff0a8;box-shadow:0 0 9px #ffd882;animation:dust var(--duration) ease-in-out infinite;animation-delay:var(--delay)}@keyframes dust{0%,100%{transform:translate3d(0,0,0) scale(.45);opacity:.1}50%{transform:translate3d(var(--dx),var(--dy),0) scale(1);opacity:.8}}
.book{width:var(--closed-book-width);height:100%;position:absolute;inset:0 auto auto 0;transform-style:preserve-3d;transform:rotateX(15deg) rotateY(-28deg);transition:transform 1.2s cubic-bezier(.25,1,.5,1);--light-x:38%;--light-y:22%;--light-angle:125deg;--shadow-x:0;will-change:transform}.book img{display:block;user-select:none;-webkit-user-drag:none}.book:after{content:"";position:absolute;bottom:-30px;left:5%;width:90%;height:40px;pointer-events:none;background:radial-gradient(ellipse,rgba(0,0,0,.7),transparent 75%);filter:blur(8px);transform:rotateX(90deg) translateX(var(--shadow-x)) translateZ(-60px);opacity:.72}
.left-page,.right-page{position:absolute;top:0;width:50%;height:100%;display:none;z-index:5;padding:24px 22px 20px;color:var(--ink);font:10.5px/1.5 Georgia,"Times New Roman",serif;text-align:justify;border:1px solid #d5c29b;background:linear-gradient(to right,#d9c59e,#f3e8cf 6%,#f1e5ca 94%,#d8c39b)}.left-page{left:0;border-radius:3px 0 0 3px;background:linear-gradient(to left,#d9c59e,#f3e8cf 6%,#f1e5ca 94%,#d8c39b);box-shadow:inset 10px 0 20px rgba(0,0,0,.06)}.right-page{right:0;border-radius:0 3px 3px 0;box-shadow:inset -5px 0 15px rgba(0,0,0,.05)}.book.open .left-page,.book.open .right-page{display:block}.left-page h2,.right-page h2{margin-bottom:8px;color:#2b2016;font-size:13px;font-weight:normal;text-align:center;letter-spacing:.5px}.left-page p,.right-page p{margin-bottom:6px;text-indent:10px}.page-number{position:absolute;bottom:8px;left:0;right:0;color:#5a4835;font-size:9px;text-align:center}.book.open .cover-group,.book.open .cover.back,.book.open .spine,.book.open .paper-block,.book.open:after{display:none}
.cover-group{position:absolute;inset:0;transform-origin:left center;transform-style:preserve-3d;transition:transform 1.8s cubic-bezier(.25,1,.5,1);z-index:30}.cover{position:absolute;inset:0;overflow:hidden;transform-style:preserve-3d;backface-visibility:hidden;border-radius:0 4px 4px 0;background:#1a1a1a}.cover img{width:100%;height:100%;object-fit:cover;object-position:center;transform:scale(var(--cover-scale,1))}.cover.front-face{z-index:2;transform:translateZ(.5px);box-shadow:2px 2px 10px rgba(0,0,0,.3)}.cover.inner-face{transform:rotateY(180deg) translateZ(.5px);background:#eadfc6}.book.open .cover-group{transform:rotateY(-180deg)}.cover.back{z-index:1;transform-origin:center;box-shadow:-5px 10px 25px rgba(0,0,0,.5)}
/* Only the spine was changed: it is a flat, solid book-casing surface with no cover image leaking into it. */
.spine{position:absolute;top:0;left:0;width:24px;height:100%;overflow:hidden;z-index:35;backface-visibility:hidden;transform-origin:left center;transform:rotateY(90deg);display:flex;align-items:center;justify-content:center;background:linear-gradient(90deg,var(--cover-shadow),var(--cover-color) 45%,var(--cover-shadow));box-shadow:inset 2px 0 5px rgba(0,0,0,.28),inset -2px 0 5px rgba(0,0,0,.28)}
.spine-title{position:absolute;top:50%;left:50%;width:100%;height:100%;display:flex;align-items:center;justify-content:center;transform:translate(-50%,-50%) rotate(-90deg);transform-origin:center;white-space:nowrap;font:700 10px/1 Georgia,"Times New Roman",serif;letter-spacing:1px;color:#fff;text-align:center;text-transform:uppercase;text-shadow:1px 1px 3px rgba(0,0,0,.75);pointer-events:none}
.paper-block{position:absolute;background:var(--paper);box-shadow:inset 0 0 8px rgba(0,0,0,.15)}.paper-front{top:2px;right:1px;height:calc(100% - 4px);transform-origin:right center;transform:rotateY(-90deg)}.paper-top{top:1px;left:2px;width:calc(100% - 4px);transform-origin:top center;transform:rotateX(-90deg)}.paper-bottom{bottom:1px;left:2px;width:calc(100% - 4px);transform-origin:bottom center;transform:rotateX(90deg)}.shine{position:absolute;inset:0;pointer-events:none;z-index:5;mix-blend-mode:screen;background:radial-gradient(ellipse 38% 24% at var(--light-x) var(--light-y),rgba(255,255,255,.32),transparent 55%),linear-gradient(var(--light-angle),rgba(255,255,255,.2),transparent 42%)}
.controls{position:fixed;bottom:max(20px,env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);z-index:100;display:flex;flex-direction:column;align-items:center;gap:8px}.rotation-hint{color:rgba(255,239,195,.92);font:600 11px/1.2 Arial,sans-serif;text-shadow:0 1px 8px #000;transition:opacity .25s,transform .25s}.rotation-hint.is-hidden{opacity:0;transform:translateY(4px);pointer-events:none}button{padding:12px 22px;border:0;border-radius:25px;background:#fff;color:#111;font-size:12px;font-weight:bold;cursor:pointer;box-shadow:0 4px 15px rgba(0,0,0,.3)}button:hover{background:#eee;transform:translateY(-2px)}
@media(max-width:700px){body{padding:18px 0 76px}.book-container{--closed-book-width:min(72vw,300px,calc((100vh - 112px)/1.563333));--open-book-width:94vw}.left-page,.right-page{padding:16px 13px 18px;font-size:clamp(8px,2.4vw,10.5px);line-height:1.38}.left-page h2,.right-page h2{font-size:clamp(10px,2.8vw,13px);margin-bottom:5px}.controls{bottom:max(12px,env(safe-area-inset-bottom))}button{padding:10px 17px;font-size:11px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</head>
<body>
<div class="particles" id="particles"></div>
<div class="book-container" id="container"><div class="fairy-dust" id="fairy-dust" aria-hidden="true"></div><div class="book" id="book" data-pages="{{sayfa_sayisi}}">
<div class="left-page"><h2>I. {{baslik}}</h2><p>{{description1}}</p><span class="page-number">118</span></div>
<div class="right-page"><h2>II. {{baslik}}</h2><p>{{description2}}</p><span class="page-number">119</span></div>
<div class="cover-group"><div class="cover front-face"><img id="cover-front-image" src="{{cover_front}}" alt="Ön Kapak" style="--cover-scale:{{cover_front_scale}}"><div class="shine"></div></div><div class="cover inner-face"></div></div>
<div class="paper-block paper-front" id="paper-front"></div><div class="paper-block paper-top" id="paper-top"></div><div class="paper-block paper-bottom" id="paper-bottom"></div>
<div class="cover back" id="cover-back"><img src="{{cover_back}}" alt="Arka Kapak" style="--cover-scale:{{cover_back_scale}}"></div>
<div class="spine" id="spine"><div class="spine-title">VADİ YAYINLARI</div></div>
</div></div>
<div class="controls"><span class="rotation-hint" id="rotation-hint">Döndürmek için kitaba tıklayın</span><button id="book-toggle" type="button" onclick="toggleBook()" aria-pressed="false">Kitabı Aç</button></div>
<script>
const book=document.getElementById("book"),container=document.getElementById("container"),spine=document.getElementById("spine"),coverBack=document.getElementById("cover-back"),paperFront=document.getElementById("paper-front"),paperTop=document.getElementById("paper-top"),paperBottom=document.getElementById("paper-bottom"),toggleButton=document.getElementById("book-toggle"),hint=document.getElementById("rotation-hint"),coverImage=document.getElementById("cover-front-image");
function createParticles(){const root=document.getElementById("particles");for(let i=0;i<18;i++){const p=document.createElement("div"),s=Math.random()*3+1.5;p.className="particle";p.style.width=p.style.height=`${s}px`;p.style.setProperty("--x",`${Math.random()*100}vw`);p.style.setProperty("--y",`${Math.random()*100}vh`);p.style.setProperty("--dx",`${(Math.random()-.5)*120}px`);p.style.setProperty("--dy",`${(Math.random()-.5)*120}px`);p.style.setProperty("--duration",`${Math.random()*8+7}s`);p.style.setProperty("--opacity",Math.random()*.25+.1);p.style.animationDelay=`-${Math.random()*6}s`;root.appendChild(p)}}
function createDust(){const root=document.getElementById("fairy-dust");for(let i=0;i<38;i++){const p=document.createElement("span"),s=Math.random()*3.8+1.1;p.style.setProperty("--size",`${s}px`);p.style.setProperty("--left",`${Math.random()*100}%`);p.style.setProperty("--top",`${Math.random()*100}%`);p.style.setProperty("--dx",`${(Math.random()-.5)*92}px`);p.style.setProperty("--dy",`${-25-Math.random()*86}px`);p.style.setProperty("--duration",`${4+Math.random()*5}s`);p.style.setProperty("--delay",`${-Math.random()*6}s`);root.appendChild(p)}}
function setSpineColor(){document.documentElement.style.setProperty("--cover-color","#d8bf66");document.documentElement.style.setProperty("--cover-shadow","#a67a2d");if(!coverImage.complete||!coverImage.naturalWidth){coverImage.addEventListener("load",setSpineColor,{once:true});return}try{const c=document.createElement("canvas"),x=c.getContext("2d");c.width=coverImage.naturalWidth;c.height=coverImage.naturalHeight;x.drawImage(coverImage,0,0,c.width,c.height);const d=x.getImageData(0,0,c.width,c.height).data;let r=0,g=0,b=0,n=0;for(let y=0;y<c.height;y+=10)for(let z=0;z<c.width;z+=10){const i=(y*c.width+z)*4,br=(d[i]+d[i+1]+d[i+2])/3;if(d[i+3]>180&&br>25){r+=d[i];g+=d[i+1];b+=d[i+2];n++}}if(n){r=Math.round(r/n);g=Math.round(g/n);b=Math.round(b/n);document.documentElement.style.setProperty("--cover-color",`rgb(${r},${g},${b})`);document.documentElement.style.setProperty("--cover-shadow",`rgb(${Math.round(r*.7)},${Math.round(g*.7)},${Math.round(b*.7)})`)}}catch(e){}}
function updateThickness(value){const pages=Math.max(1,parseInt(value,10)||100),t=Math.max(12,Math.min(90,Math.round(pages*.12)));spine.style.width=`${t}px`;spine.style.setProperty("--spine-title-size",`${Math.max(6,Math.min(11,t*.34))}px`);coverBack.style.transform=`translateZ(-${t}px) rotateY(180deg)`;paperFront.style.width=`${Math.max(10,t-2)}px`;paperTop.style.height=`${Math.max(10,t-2)}px`;paperBottom.style.height=`${Math.max(10,t-2)}px`;book.dataset.pages=pages}
let isOpen=false,mouseRotation=false,activePointerId=null,previous={x:0,y:0},rotation={x:15,y:-28};function updateLighting(){book.style.setProperty("--light-x",`${Math.max(12,Math.min(88,38+rotation.y*.55))}%`);book.style.setProperty("--light-y",`${Math.max(12,Math.min(58,22-rotation.x*.28))}%`);book.style.setProperty("--light-angle",`${125+rotation.y*.65}deg`);book.style.setProperty("--shadow-x",`${Math.max(-34,Math.min(34,rotation.y*-.75))}px`)}function applyRotation(){book.style.transform=`translateX(0) rotateX(${rotation.x}deg) rotateY(${rotation.y}deg) rotateZ(0deg)`;updateLighting()}function disableRotation(){mouseRotation=false;container.classList.remove("rotation-active");book.style.transition=""}function toggleBook(){isOpen=!isOpen;disableRotation();container.classList.toggle("open",isOpen);book.classList.toggle("open",isOpen);if(isOpen){book.style.transform="none";toggleButton.textContent="Kitabı Kapat";toggleButton.setAttribute("aria-pressed","true")}else{rotation={x:15,y:-28};applyRotation();toggleButton.textContent="Kitabı Aç";toggleButton.setAttribute("aria-pressed","false");updateThickness(book.dataset.pages)}}
container.addEventListener("pointerdown",e=>{if(isOpen||(e.pointerType==="mouse"&&e.button!==0))return;e.preventDefault();hint.classList.add("is-hidden");previous={x:e.clientX,y:e.clientY};if(e.pointerType==="mouse"){mouseRotation=!mouseRotation;container.classList.toggle("rotation-active",mouseRotation);book.style.transition=mouseRotation?"none":""}else{activePointerId=e.pointerId;book.style.transition="none";container.setPointerCapture(e.pointerId)}});container.addEventListener("pointermove",e=>{const active=(e.pointerType==="mouse"&&mouseRotation)||e.pointerId===activePointerId;if(isOpen||!active)return;e.preventDefault();rotation.y+=(e.clientX-previous.x)*1.15;rotation.x=Math.max(-60,Math.min(60,rotation.x-(e.clientY-previous.y)*1.15));previous={x:e.clientX,y:e.clientY};applyRotation()});function finishDrag(e){if(e.pointerId!==activePointerId)return;activePointerId=null;book.style.transition="";if(container.hasPointerCapture(e.pointerId))container.releasePointerCapture(e.pointerId)}container.addEventListener("pointerup",finishDrag);container.addEventListener("pointercancel",finishDrag);container.addEventListener("lostpointercapture",finishDrag);window.addEventListener("keydown",e=>{if(e.key==="Escape")disableRotation()});
createParticles();createDust();updateThickness(book.dataset.pages);setSpineColor();updateLighting();
</script>
</body>
</html>
