     <section class="section active-applications-section">
      <div class="col-12 col-lg-12">
        <div class="card active-applications-card">
          <div class="card-header active-applications-header">
            <div>
            
              <h4 class="mb-0">Aktif Başvurular</h4>
            </div>
          </div>
          <div class="card-body p-0">
            {% if aktif_basvurular %}
              <div class="table-responsive">
                <table class="table active-applications-table mb-0">
                  <thead>
                    <tr>
                      <th>Başvuru adı</th>
                                        <th>Tür</th>
                      <th>Başlangıç tarihi</th>
                      <th>Son başvuru tarihi</th>
                      <th>Durum</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for basvuru in aktif_basvurular %}
                      <tr>
                        <td><div class="active-application-name"><span class="active-application-mark"><i class="bi bi-file-earmark-text"></i></span>{{basvuru.name}}</div></td>
                                            <td><span class="active-application-type active-application-type-{{basvuru.category}}">{% if basvuru.category == 'udef' %}UDEF{% elseif basvuru.category == 'burs' %}Burs{% elseif basvuru.category == 'ozel' %}Özel{% else %}Genel{% endif %}</span></td>
                                            <td>{{basvuru.date}}</td>
                                            <td>{% if basvuru.end_date %}{{basvuru.end_date}}{% else %}<span class="text-muted">Süresiz</span>{% endif %}</td>
                        <td><span class="active-application-status"><i class="bi bi-check-circle-fill"></i>{{basvuru.status}}</span></td>
                                            <td class="text-end"><a href="{{basvuru.link}}" class="active-application-button">Başvur <i class="bi bi-arrow-right"></i></a></td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            {% else %}
              <div class="active-applications-empty"><i class="bi bi-inbox"></i><span>Şu anda aktif başvuru bulunmuyor.</span></div>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
   
	<section class="section">
    <div class="col-12 col-lg-12">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Dernek İstatistikleri</h4>
                    </div>
                    <div class="card-body">
                        <div id="chart" style="min-height: 315px;">

                                
                         </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
   </section>

   <section class="section" id="etkinlikler" style="display:none;">
   <div class="row match-height">
            <div class="col-lg-12 col-md-12">
                <div class="card" >
                    <div class="card-header" id="list-group-baslik"></div>
                        <div class="card-body" >
                          <div style="height: 300px; overflow: auto;">
                            <ul class="list-group" >
                                
                                
                            </ul>
                            </div>
                        </div>
                    </div>
            </div>
      </section>      
    <section class="section" >
      
  <div id="map" class="row">
  <iframe 
    width="100%" 
    height="450" 
    loading="eager" 
    style="border: none;"
    srcdoc='
      <!DOCTYPE html>
      <html lang="tr">
        <head>
          <style>
            html, body {
              margin: 0;
              padding: 0;
              height: 100%;
              overflow: hidden;
            }
            iframe {
              width: 100%;
              height: 600px;
              border: none;
            }
          </style>
        </head>
        <body>
          <iframe 
            src="{{map_url}}" 
            allowfullscreen 
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </body>
      </html>'
  ></iframe>
</div>
               
    </section>
   
<style>
.bg-info {
    background-color: #018bd3;
    color:#fff;
}

.active-applications-card { overflow: hidden; border: 0; box-shadow: 0 8px 24px rgba(33, 56, 75, .06); }
.active-applications-header { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px; border-bottom: 1px solid #eef1f4; }
.active-applications-eyebrow { display: block; margin-bottom: 4px; color: #018bd3; font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
.active-applications-link { color: #018bd3; font-size: 13px; font-weight: 600; text-decoration: none; }
.active-applications-link i { margin-left: 4px; }
.active-applications-table { min-width: 760px; }
.active-applications-table thead th { padding: 13px 24px; color: #98a2b3; background: #fbfcfd; border-bottom: 1px solid #eef1f4; font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; }
.active-applications-table tbody td { padding: 16px 24px; color: #596773; border-bottom: 1px solid #f0f2f5; font-size: 13px; vertical-align: middle; white-space: nowrap; }
.active-applications-table tbody tr:last-child td { border-bottom: 0; }
.active-applications-table tbody tr:hover { background: #fcfeff; }
.active-application-name { display: flex; align-items: center; gap: 11px; min-width: 230px; color: #263238; font-size: 14px; font-weight: 700; white-space: normal; }
.active-application-mark { display: inline-flex; flex: 0 0 38px; align-items: center; justify-content: center; width: 38px; height: 38px; color: #018bd3; background: #e8f6fc; border-radius: 11px; font-size: 17px; }
.active-application-status { display: inline-flex; align-items: center; gap: 5px; padding: 6px 9px; color: #198754; background: #eaf8f0; border-radius: 20px; font-size: 12px; font-weight: 700; white-space: nowrap; }
.active-application-type { display: inline-flex; padding: 5px 9px; border-radius: 7px; font-size: 11px; font-weight: 700; white-space: nowrap; }
.active-application-type-genel { color: #35608a; background: #eaf3fb; }
.active-application-type-udef { color: #147a6b; background: #e4f7f2; }
.active-application-type-burs { color: #8b6110; background: #fff4d6; }
.active-application-type-ozel { color: #7652a1; background: #f1eafd; }
.active-application-button { display: inline-flex; align-items: center; gap: 5px; padding: 8px 11px; color: #018bd3; border: 1px solid #b8e2f3; border-radius: 7px; font-size: 12px; font-weight: 700; text-decoration: none; white-space: nowrap; }
.active-application-button:hover { color: #fff; background: #018bd3; }
.active-applications-empty { display: flex; align-items: center; gap: 12px; padding: 28px 24px; color: #7a8793; font-size: 14px; }
.active-applications-empty i { color: #018bd3; font-size: 24px; }
.active-applications-table tbody tr:last-child td { border-bottom: 0; }
html[data-bs-theme="dark"] .active-application-name { color: #f4f6f8; }
html[data-bs-theme="dark"] .active-applications-header, html[data-bs-theme="dark"] .active-applications-table thead th, html[data-bs-theme="dark"] .active-applications-table tbody td { border-color: #3b4248; }
html[data-bs-theme="dark"] .active-applications-table thead th { background: #292f34; }
html[data-bs-theme="dark"] .active-applications-table tbody tr:hover { background: #2a3035; }
@media (max-width: 767.98px) {
  .active-applications-header { padding: 18px; }
  .active-applications-table thead th, .active-applications-table tbody td { padding-right: 18px; padding-left: 18px; }
  .active-applications-empty { flex-wrap: wrap; padding: 24px 18px; }
}

#map iframe {
  overflow: hidden;
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE 10+ */


}


</style>
{{ footer }}
</div>
</div>
<script>
  var options = {
    series: [
      {
        name: 'Etkinlikler (Bu Yıl)',
        data: {{ data_egitim1|raw }},
      },
      {
        name: 'Etkinlikler (Geçen Yıl)',
        data: {{ data_egitim2|raw }},
      },
    ],
    chart: {
      type: 'bar',
      height: 350,
      events: {
        dataPointSelection: function(event, chartContext, config) {
            var category = options.xaxis.categories[config.dataPointIndex];
            $('#etkinlikler .card-header').find('h4').remove();
            $('#etkinlikler .list-group').find('li').remove();
            etkinlikler(category);
             $('#etkinlikler').show();
        }

      }
    },
    colors: ['#008FFB', '#fa5552'],
    plotOptions: {
      bar: {
        horizontal: false,
        columnWidth: '80%',
        borderRadius: 5,
        borderRadiusApplication: 'end'
      }
    },
    dataLabels: {
      enabled: false
    },
    stroke: {
      show: true,
      width: 2,
      colors: ['transparent']
    },
    xaxis: {
      categories: ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık']
    },
    yaxis: {
      title: {
        text: 'Etkinlik Sayıları'
      }
    },
    fill: {
      opacity: 1
    },
    tooltip: {
      y: {
        formatter: function (val) {
          return val + " etkinlik";
        }
      }
    }
  };

  var chart = new ApexCharts(document.querySelector("#chart"), options);
  chart.render();
</script>

<script>

function etkinlikler(ay) {
    $.ajax({
    url: 'index.php?route=account/account/etkinlikname&ay=' + ay,
    type: 'post',
    success: function(json) {
    
        if(json['error']['ay']) {
            $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fas fa-exclamation-circle"></i> ' + json['error']['ay'] + '</div>');
        }
        
        if (json['html']) {
             $('#list-group-baslik').append(json['html_baslik']);
            $('#etkinlikler .list-group').append(json['html']);
           
        }
		
	 },

     error: function (xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
     }

	});

}

</script>